{
  "name": "chat-component",
  "type": "module",
  "packageManager": "yarn@4.16.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "postinstall": "test -f .hi && (is-ci || husky) || true",
    "lint": "yarn lint:code",
    "lint:code": "eslint --color ./src/",
    "lint:code:fix": "eslint --fix --color ./src/",
    "lint:code:staged": "eslint --fix --color",
    "commit": "cz",
    "sdk:vscode": "yarn dlx @yarnpkg/sdks vscode"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/eslint-plugin-tailwindcss": "^3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-functional": "^9.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "4.0.0-alpha.5",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.0.6",
    "neostandard": "0.12.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.3.5"
  },
  "dependenciesMeta": {
    "prettier-plugin-tailwindcss@0.8.0": {
      "unplugged": true
    },
    "shadcn@4.10.0": {
      "unplugged": true
    },
    "tw-animate-css@1.4.0": {
      "unplugged": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
